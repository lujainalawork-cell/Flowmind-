# FlowMind — optional environment settings
#
# NONE of these are required. With no settings at all, FlowMind runs fully
# offline on its built-in deterministic rules engine, which is how this tester
# build is meant to be used. Detection, the opportunity score and the confidence
# level are always computed by deterministic code, never by a model.
#
# If you want the consultant's *wording* to be generated by Claude instead of the
# rules engine, set ANTHROPIC_API_KEY in your own environment before starting the
# server. Do not put a real key in this file, and never commit one.
#
#   Windows (PowerShell):  $env:ANTHROPIC_API_KEY="your_api_key_here"
#   Windows (cmd):         set ANTHROPIC_API_KEY=your_api_key_here
#   macOS / Linux:         export ANTHROPIC_API_KEY=your_api_key_here

ANTHROPIC_API_KEY=your_api_key_here

# Force the offline rules engine even when a key is present.
FLOWMIND_DISABLE_AI=0

# Seconds to wait for the model before falling back to the rules engine.
FLOWMIND_AI_TIMEOUT=12

# Where the local SQLite database is created. Leave unset: FlowMind puts it in
# the project folder automatically and creates it on first launch.
# FLOWMIND_DB=
